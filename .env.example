# Ollama 本地推理（選配）
# 必須設為 0.0.0.0 才能讓 VM sandbox 存取 host 上的 Ollama
# 預設值 127.0.0.1 只允許本機存取，sandbox 無法連到
OLLAMA_HOST=0.0.0.0
# 限制同時載入的模型數量
# 32GB RAM + 分層推理（e2b ~1.5GB）可設為 2
# 24GB RAM 建議設 1
OLLAMA_MAX_LOADED_MODELS=2

# ── claude-dev Messaging Bridge Bot Tokens ─────────────────────────────────
# 複製此檔為 .env 並填入實際 token

# Telegram（claude-dev 專屬 bot）
# 從 @BotFather 取得（格式：123456:ABC-DEF...）
TELEGRAM_TOKEN=

# Slack（claude-dev 專屬 App）
# Bot Token：從 OAuth & Permissions 取得（xoxb-...）
SLACK_BOT_TOKEN=
# App Token：從 Socket Mode 取得（xapp-...）
SLACK_APP_TOKEN=

# Discord（可選，留空則不啟用）
DISCORD_TOKEN=

# 白名單設定（空格分隔多個 ID，留空=不限制）
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# ── claw-agent OpenClaw Channel Tokens ────────────────────────────────────
# claw-agent 用 OpenClaw 內建 channel 整合，各自獨立 bot
# make setup-claw 時會互動式詢問要啟用哪些 channel
# 也可事後進入 sandbox 用 openclaw configure --section channels 設定

# Telegram（claw-agent 專屬 bot，@BotFather /newbot 建立）
CLAW_TELEGRAM_TOKEN=
CLAW_TELEGRAM_ALLOWED_CHAT_IDS=
CLAW_TELEGRAM_ALLOWED_USER_IDS=

# Discord（claw-agent 專屬 bot）
# Discord Developer Portal → New Application → Bot → Token
CLAW_DISCORD_TOKEN=
CLAW_DISCORD_APP_ID=

# Slack（claw-agent 專屬 Slack App，api.slack.com → Create New App → Socket Mode）
CLAW_SLACK_BOT_TOKEN=
CLAW_SLACK_APP_TOKEN=

# LINE（claw-agent 專屬 LINE Official Account）
# LINE Developers Console → Messaging API → Channel access token + Channel secret
CLAW_LINE_CHANNEL_TOKEN=
CLAW_LINE_CHANNEL_SECRET=
